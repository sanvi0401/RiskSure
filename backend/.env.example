# PostgreSQL connection string for production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/risksure

# Strong random secret used to sign authentication tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Neon PostgreSQL (use your Neon pooled connection string if preferred)
NEON_DATABASE_URL=

# Frontend origin allowed by production CORS
FRONTEND_ORIGIN=

# Optional Hugging Face inference API token for policy/claims AI
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=

# Optional Chroma vector database endpoint
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_API_KEY=

# Optional Neo4j graph database
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Production controls
FLASK_ENV=production
AUTO_CREATE_TABLES=false

# Encrypts TOTP secrets at rest. Generate a Fernet key; never commit it.
TOTP_ENCRYPTION_KEY=

# Optional YOLO model path for claim image intelligence.
YOLO_MODEL_PATH=

# Optional Hugging Face embedding model; separate from the generation model.
HUGGINGFACE_EMBEDDING_MODEL=

# Chroma collection name.
CHROMA_COLLECTION=risksure_policies
