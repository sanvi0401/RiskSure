# ─────────────────────────────────────────────────────────────────────────────
# RiskSure backend environment.
# Local: copy to backend/.env.   Production: add each value in your host's
# dashboard (Vercel → Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# "production" enables strict checks (DB + JWT secret required, no localhost CORS).
# Leave empty for local development.
FLASK_ENV=

# ── Required in production ───────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Render, RDS…). Local dev falls
# back to SQLite when empty. postgres:// and postgresql:// are both accepted.
# Neon example: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/risksure?sslmode=require
DATABASE_URL=
# Alternative name read if DATABASE_URL is empty (e.g. Vercel's Neon integration).
NEON_DATABASE_URL=

# Long random secret for signing login tokens. Changing it logs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Encrypts Google Authenticator secrets at rest. Never change it after users
# enrol, or their authenticator codes stop working.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Only needed if the browser calls the backend directly (not via the frontend's
# /api proxy). Comma-separated, no trailing slash.
FRONTEND_ORIGINS=

# ── Database schema ──────────────────────────────────────────────────────────
# true: create missing tables / widen legacy columns on startup (recommended on
# Vercel, where no release step runs). false: manage schema with `flask db upgrade`.
AUTO_CREATE_TABLES=true

# ── Optional tuning ──────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Shared rate-limit storage across instances, e.g. redis://default:PASS@host:6379
RATELIMIT_STORAGE_URI=memory://

# ── Optional AI / data integrations (features degrade gracefully if empty) ───
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=
HUGGINGFACE_EMBEDDING_MODEL=

CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_API_KEY=
CHROMA_COLLECTION=risksure_policies

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

YOLO_MODEL_PATH=
