# Base path the browser uses for API calls. Keep /api so requests go through
# the Next.js proxy below (same origin → no CORS problems).
NEXT_PUBLIC_API_BASE_URL=/api

# Where /api/* is proxied to (server-side, read at build time).
# Local:      http://localhost:5001
# Production: your deployed backend URL, e.g. https://risksure-api.vercel.app
BACKEND_API_URL=http://localhost:5001
